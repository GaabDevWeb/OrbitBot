# Obrigatórias
OPENROUTER_API_KEY=sk-or-v1-sua-chave
# Números admin (só dígitos com DDI, separados por vírgula). Ex: 5554999999999
ADMIN_NUMBERS=5554999999999

# Opcionais — OpenRouter / IA
# Lista ordenada de modelos (primário + fallbacks). Se o 1º falhar, tenta o seguinte.
# Formato JSON array (recomendado) ou CSV:
OPENROUTER_MODELS=["deepseek/deepseek-chat-v3-0324:free","google/gemini-2.0-flash-exp:free","openrouter/free"]
# Alternativa CSV: OPENROUTER_MODELS=deepseek/deepseek-chat-v3-0324:free,google/gemini-2.0-flash-exp:free,openrouter/free
# Compat (modelo único): OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324:free
OPENAI_MAX_RETRIES=3
OPENAI_INITIAL_TIMEOUT=8000
OPENAI_MAX_TIMEOUT=30000
# OPENROUTER_TEMPERATURE=0.7
# OPENROUTER_MAX_TOKENS=800
# OPENAI_MAX_HISTORY=10

# Persona (system prompt) — caminho opcional; default: prompts/SYSTEM.md
# SYSTEM_PROMPT_PATH=prompts/SYSTEM.md

# Opcionais — logs
LOG_LEVEL=info
BAILEYS_LOG_LEVEL=silent
