# Obrigatórias
# Números admin (só dígitos com DDI, separados por vírgula). Ex: 5554999999999
ADMIN_NUMBERS=5554999999999

# --- Kernel (cérebro — POST /v1/chat) ---
# URL base do Kernel (sem /v1). Default: http://127.0.0.1:8001
KERNEL_API_URL=http://127.0.0.1:8001
# Bearer opcional (mesmo token no Kernel: ACL_API_BEARER_TOKEN
# ou whatsapp:… em ACL_CHANNEL_API_KEYS). Se vazio, não envia header.
# KERNEL_API_TOKEN=
# Timeout HTTP ms (default 60000)
# KERNEL_API_TIMEOUT_MS=60000
# Token interno Kernel (TRACE): POST /internal/traces/events
# ACL_INTERNAL_BEARER_TOKEN=
# HTTP interno outbound (Comunicações Kernel → WhatsApp)
# ORBIT_INTERNAL_HOST=127.0.0.1
# ORBIT_INTERNAL_PORT=8010

# Legado OpenRouter (não usado no fluxo principal — rollback manual apenas)
# OPENROUTER_API_KEY=sk-or-v1-sua-chave
# OPENROUTER_MODELS=["deepseek/deepseek-chat-v3-0324:free"]

# Opcionais — logs
LOG_LEVEL=info
BAILEYS_LOG_LEVEL=silent

# Persona local (admin/stats); o Kernel usa os próprios system prompts
# SYSTEM_PROMPT_PATH=prompts/SYSTEM.md
