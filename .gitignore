# Dependências
node_modules/

# Sessão WhatsApp (Baileys)
auth/
auth.backup.*/
tokens/
*.session
wppconnect-session/

# Logs
logs/
*.log

# Arquivos temporários
*.tmp
*.temp

# Arquivos de ambiente
.env
.env.local
.env.production

# Arquivos do sistema
.DS_Store
Thumbs.db

# Arquivos de IDE
.vscode/
.idea/
*.swp
*.swo

# Dev / agentes (não operacional)
test/
memory/
tools/
.agent_history.md

# Arquivos de backup (exceto logs de backup)
database/backups/*/
!database/backups/backup_log.json

# Banco SQLite local (não versionar dados reais)
database/data/*
!database/data/.gitkeep

# Arquivos de cache
.cache/
*.cache

# Exports de histórico WhatsApp
exports/*
!exports/.gitkeep